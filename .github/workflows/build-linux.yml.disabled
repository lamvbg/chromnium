name: build-chronium-linux

# GH free ubuntu-latest (4 vCPU / 16 GB) needs ~8h for Chromium 148
# first build, but the runner caps at 6h. Strategy: sccache. Every run
# reads/writes an sccache cache stored via `actions/cache`. First run
# builds ~4h worth of objects then hits the timeout; second run reads
# them back in seconds and continues from there; after 2-3 runs the
# cache is complete and every subsequent run finishes in 30-60 min.
#
# The cache key includes the Chromium tag + a hash of patches so a
# patch edit invalidates the affected layer without nuking the whole
# cache. sccache handles the fine-grained skipping.
#
# Trigger with workflow_dispatch (from the Actions tab) or push a
# `linux-v*` tag.

on:
  workflow_dispatch:
    inputs:
      chromium_tag:
        description: 'Chromium base tag'
        required: true
        default: '148.0.7778.217'
      release_tag:
        description: 'GitHub release tag to publish under'
        required: true
        default: 'linux-v0.1.5'
  push:
    tags:
      - 'linux-v*'

jobs:
  build:
    runs-on: ubuntu-latest
    # Full 6h budget. GH Actions cap is 360 min; leaving 5 min lets the
    # Post * cleanup steps run after autoninja returns.
    timeout-minutes: 355

    steps:
      - name: Free disk space
        run: |
          df -h /
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
                      /usr/local/share/boost \
                      "$AGENT_TOOLSDIRECTORY" \
                      /opt/hostedtoolcache \
                      /usr/share/swift /usr/lib/jvm
          sudo docker system prune -af 2>/dev/null || true
          sudo apt-get clean
          df -h /

      - name: Checkout chronium-build (this repo)
        uses: actions/checkout@v4
        with:
          path: chronium-build

      # sccache removed 2026-07-06: mozilla-actions/sccache-action + the
      # actions/cache backend it wraps kept returning "Our services
      # aren't available right now" for hours (Azure Edge issue on
      # GH's side). Every clang++ invocation was going through sccache
      # first, hitting the failed backend, and exiting non-zero — so
      # ninja registered every compile as FAILED and the build died at
      # step ~1200 of 75851. Falling back to a plain build. If we
      # can't fit inside the 6h cap that's a separate problem to solve
      # (larger runner, split job, etc.), but at least it will make
      # forward progress.

      - name: Install system deps
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends \
            git python3 python3-pip curl file lsb-release sudo wget gnupg \
            xz-utils build-essential lld clang \
            pkg-config libnss3-dev libgtk-3-dev libxss-dev libasound2-dev

      - name: Clone depot_tools
        run: |
          git clone --depth 1 https://chromium.googlesource.com/chromium/tools/depot_tools.git \
                    "$HOME/depot_tools"
          echo "$HOME/depot_tools" >> $GITHUB_PATH

      # ---- Cache the Chromium checkout ----
      # ~30 GB total which is over GH's 10 GB per-repo cap, so we only
      # cache the parts that DON'T change tag-to-tag and take longest
      # to fetch. Full first-time fetch stays ~30 min; every subsequent
      # run reuses the .git objects and the third_party/ submodules
      # that are big and stable.
      - name: Fetch Chromium source
        run: |
          mkdir -p $HOME/cr
          cd $HOME/cr
          cat > .gclient <<'EOF'
          solutions = [
            {
              "name": "src",
              "url": "https://chromium.googlesource.com/chromium/src.git",
              "custom_deps": {},
              "custom_vars": {"checkout_pgo_profiles": True},
            },
          ]
          target_os = ["linux"]
          EOF
          gclient sync --nohooks --no-history --revision src@refs/tags/${{ github.event.inputs.chromium_tag || '148.0.7778.217' }} -j 4

      - name: Run hooks (installs Linux toolchain)
        run: |
          cd $HOME/cr
          gclient runhooks

      - name: Apply chronium patches
        run: |
          cd $HOME/cr/src
          git config user.email 'chronium@interlink.local'
          git config user.name 'Chronium'

          for p in $(ls $GITHUB_WORKSPACE/chronium-build/patches/00{01,02,03,04,05,06,07,08,09,10,11,12,13,14,15,16,17,18}-*.patch 2>/dev/null); do
            echo "Applying $(basename $p) ..."
            git am --keep-cr --3way < "$p" || { echo "PATCH FAILED: $p"; exit 1; }
          done

          POSTPATCH=$GITHUB_WORKSPACE/chronium-build/patches/post-patched
          if [ -d "$POSTPATCH" ]; then
            echo "Copying post-patched files (0019+0020+0021 squashed) ..."
            cp -rv "$POSTPATCH"/. .
            git add -A
            git commit -m "chronium: patches 0019+0020+0021" || true
          fi

          git log --oneline -25

      - name: Generate license_secret.h
        env:
          KEY_HEX: ${{ secrets.CHRONIUM_LICENSE_KEY_HEX }}
        run: |
          if [ -z "$KEY_HEX" ]; then
            echo "CHRONIUM_LICENSE_KEY_HEX repo secret not set — using zero key"
            KEY_HEX=$(printf '00%.0s' {1..32})
          fi
          python3 - <<'PY'
          import os, textwrap
          key = os.environ['KEY_HEX']
          bytes_arr = ',\n    '.join(
              ', '.join(f'0x{key[i+j*2:i+j*2+2]}' for j in range(8))
              for i in range(0, 64, 16)
          )
          content = f'''// Auto-generated in GitHub Actions from repo secret.
          #ifndef CHROME_BROWSER_LICENSE_LICENSE_SECRET_H_
          #define CHROME_BROWSER_LICENSE_LICENSE_SECRET_H_
          #include <cstdint>
          namespace chronium {{
          inline constexpr uint8_t kLicenseSecret[32] = {{
              {bytes_arr}
          }};
          }}  // namespace chronium
          #endif
          '''
          os.makedirs(os.path.expanduser('~/cr/src/chrome/browser/license'), exist_ok=True)
          with open(os.path.expanduser('~/cr/src/chrome/browser/license/license_secret.h'), 'w') as f:
              f.write(textwrap.dedent(content))
          PY

      - name: gn gen
        run: |
          cd $HOME/cr/src
          mkdir -p out/Release
          cat > out/Release/args.gn <<'GNARGS'
          is_debug = false
          is_component_build = true
          symbol_level = 0
          chrome_pgo_phase = 0
          use_official_google_api_keys = false
          use_thin_lto = false
          enable_widevine = false
          proprietary_codecs = true
          ffmpeg_branding = "Chrome"
          enable_platform_hevc = true
          enable_hevc_parser_and_hw_decoder = true
          enable_platform_ac3_eac3_audio = true
          target_cpu = "x64"
          target_os = "linux"
          blink_symbol_level = 0
          v8_symbol_level = 0
          use_lld = true
          GNARGS
          gn gen out/Release

      - name: autoninja chrome
        run: |
          cd $HOME/cr/src
          autoninja -C out/Release chrome -j 8

      - name: Package chronium-linux
        run: |
          cd $HOME/cr/src/out/Release
          mkdir -p /tmp/chronium/bin
          cp chrome chrome_crashpad_handler /tmp/chronium/bin/ || true
          cp libEGL.so libGLESv2.so libvk_swiftshader.so libvulkan.so.1 \
             vk_swiftshader_icd.json /tmp/chronium/bin/ 2>/dev/null || true
          cp resources.pak chrome_100_percent.pak chrome_200_percent.pak \
             icudtl.dat snapshot_blob.bin v8_context_snapshot.bin \
             /tmp/chronium/bin/
          cp -r Locales /tmp/chronium/bin/
          mkdir -p /tmp/chronium/config
          cp -r $GITHUB_WORKSPACE/chronium-build/config/profiles /tmp/chronium/config/
          cp -r $GITHUB_WORKSPACE/chronium-build/scripts /tmp/chronium/
          echo "${{ github.event.inputs.release_tag || github.ref_name }}" > /tmp/chronium/VERSION

          cd /tmp
          TARBALL=chronium-linux-${{ github.event.inputs.release_tag || github.ref_name }}.tar.gz
          tar czf $TARBALL chronium/
          ls -lh $TARBALL
          echo "TARBALL_PATH=/tmp/$TARBALL" >> $GITHUB_ENV

      - name: Upload tarball as artifact
        uses: actions/upload-artifact@v4
        with:
          name: chronium-linux-tarball
          path: ${{ env.TARBALL_PATH }}
          retention-days: 30

      - name: Publish to GitHub release
        if: startsWith(github.ref, 'refs/tags/linux-v')
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.ref_name }}
          files: ${{ env.TARBALL_PATH }}
          body: |
            Linux build of chronium ${{ github.ref_name }}. Built on
            ubuntu-latest with sccache; patches 0001-0021 applied.
